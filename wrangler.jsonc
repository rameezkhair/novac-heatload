// Cloudflare Workers deployment: the Worker serves the Vite build in dist/ on novac.ae (index.html is the landing page,
// app.html the calculator, admin.html the admin panel at /admin) and the API in worker/index.ts:
//   /api/admin/* and /api/config (admin login and site settings), /api/diesel (live UAE diesel price), /api/subscribe (newsletter),
//   /api/user/* (user accounts for the Pro tools: login codes emailed from no-reply@novac.ae through Brevo).
// It is deployed by .github/workflows/deploy-cloudflare.yml on every push to main, which needs these GitHub repository secrets:
//   CLOUDFLARE_API_TOKEN     a Cloudflare API token from the "Edit Cloudflare Workers" template, with the novac.ae zone
//   CLOUDFLARE_ACCOUNT_ID    Cloudflare dashboard → Workers & Pages → Account ID
//   ADMIN_EMAIL, ADMIN_PASSWORD_HASH, SESSION_SECRET   the admin login: run `npm run admin:hash` for the last two;
//                            SESSION_SECRET also signs the users' login cookies
//   Brevo: the API key is set once as a Worker secret (`npx wrangler secret put BREVO_API_KEY`, or the dashboard);
//   the contact list is BREVO_LIST_ID under "vars" below. The same key sends the login codes, from no-reply@novac.ae, so
//   novac.ae has to be an authenticated domain in Brevo (Senders, Domains & Dedicated IPs → Domains).
// The admin settings are kept in the KV namespace "novac-site"; the workflow creates it on the first deploy and puts its id
// in place of __SITE_KV_ID__ (scripts/ensure-kv.mjs).
// Local testing: `npm run dev` serves the same API; the admin login comes from .dev.vars (not committed), the settings
// are kept in .novac-site.json and the users in .novac-dev.sqlite.
// The D1 database "novac" (binding DB) keeps the user accounts and the newsletter consent records. Its tables are in
// migrations/; the workflow applies new ones before each deploy (npx wrangler d1 migrations apply novac --remote).
{
  "name": "novac-heatloadcalculator",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  /* the Worker answers everything on novac.ae; www.novac.ae keeps redirecting to it */
  "routes": [{ "pattern": "novac.ae/*", "zone_name": "novac.ae" }],
  "kv_namespaces": [{ "binding": "SITE", "id": "__SITE_KV_ID__" }],
  "d1_databases": [{ "binding": "DB", "database_name": "novac", "database_id": "67b13201-81c0-4696-9d3c-a187278ff397", "migrations_dir": "migrations" }],
  "observability": { "enabled": true },
  /* Brevo: newsletter sign-ups go to this contact list; the API key is the Worker secret BREVO_API_KEY */
  "vars": { "BREVO_LIST_ID": "3" }
}
